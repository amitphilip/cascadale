# Supabase project: Project Settings → API Keys. The app signs users in and acts as them,
# so it only needs the publishable key; row level security keeps each user to their rows.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Cas, the old in-app agent (plan making, short-term redo, ask_cas, AI categorization).
# Off unless "true": Claude plans through the MCP tools instead, and nothing calls the API.
CAS_ENABLED=

# Optional fallback when no key is saved under Settings → AI (only used with CAS_ENABLED=true).
ANTHROPIC_API_KEY=

# Optional fallback when no Akahu tokens are saved under Settings → Bank feeds.
# Every signed-in user syncs from this Akahu account, so only set it for a single-user setup.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# Web Push for Cas messages: the public half of the VAPID pair (the private half is an
# akahu-sync function secret). See README, "Cas's messages".
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
