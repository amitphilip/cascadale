# Supabase project: Project Settings → API Keys. The app signs users in and acts as them,
# so it only needs the publishable key; row level security keeps each user to their rows.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional fallback when no key is saved under Settings → AI.
ANTHROPIC_API_KEY=

# Optional fallback when no Akahu tokens are saved under Settings → Bank feeds.
# Every signed-in user syncs from this Akahu account, so only set it for a single-user setup.
AKAHU_APP_TOKEN=
AKAHU_USER_TOKEN=

# Inngest runs Cas in the background after each sync and plan change (app/api/inngest).
# For local development run `npx inngest-cli@latest dev` and set INNGEST_DEV=1 instead.
# The akahu-sync edge function needs INNGEST_EVENT_KEY as a Supabase secret too.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Lets Cas's background worker sign in as a household's owner (lib/db/household.ts), so it
# reads through row level security like the app. Server only: never expose it to the browser.
SUPABASE_SECRET_KEY=

# Optional: Cas's models per tier (Settings rows casModel.default / .escalate / .deep win).
# Defaults: claude-haiku-5-5 for snapshot runs, claude-sonnet-5-5 for check-ins, ask_cas,
# the Plan chat and escalated runs, claude-opus-5-5 for deep reviews and new plans.
CAS_MODEL_DEFAULT=
CAS_MODEL_ESCALATE=
CAS_MODEL_DEEP=
# Categorisation stays on the deep model unless this is set.
CAS_MODEL_CATEGORISE=
# How far the goal's gap moves between runs before the next one escalates (default 250).
CAS_ESCALATE_GAP=
